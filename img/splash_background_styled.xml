<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Fundo base -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#080808" />
        </shape>
    </item>

    <!-- Marcas de arranhão no canto superior direito (Estilo DBD) -->
    <item android:top="20dp" android:right="20dp" android:gravity="top|right">
        <vector android:width="100dp" android:height="100dp" android:viewportWidth="100" android:viewportHeight="100">
            <path android:pathData="M80,10 L75,40" android:strokeColor="#1AFFFFFF" android:strokeWidth="1" />
            <path android:pathData="M85,12 L80,42" android:strokeColor="#1AFFFFFF" android:strokeWidth="1" />
            <path android:pathData="M90,14 L85,44" android:strokeColor="#1AFFFFFF" android:strokeWidth="1" />
        </vector>
    </item>

    <!-- Ícone Principal no Centro -->
    <item
        android:drawable="@mipmap/ic_launcher"
        android:width="120dp"
        android:height="120dp"
        android:gravity="center" />

</layer-list>
